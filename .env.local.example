# Copy this file to .env.local for local development.
# .env.local is gitignored and never deployed.
#
# The mock API is ON by default whenever NODE_ENV=development (i.e. npm run dev).
# No env vars are required for basic local development.
#
# To proxy to the real internal backend instead of returning mock data,
# add the line below (requires access to the internal network):
# MOCK_API=false
#
# The backend this app proxies to when MOCK_API=false. Defaults to Django on
# the production box (127.0.0.1:8009). Note that :8999 is a *different*
# service — the unauthenticated public FastAPI chat — so do not point this
# there. See lib/server/backend.ts for the routing table.
# BACKEND_BASE_URL=http://127.0.0.1:8009
